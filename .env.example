# APP_URL: The public URL/domain where this server is hosted (e.g. Cloud Run
# service URL). Used to build the vless://, vmess://, trojan:// client links
# sent by the Telegram bot (host/sni fields). AI Studio / Cloud Run usually
# inject this automatically -- if running elsewhere, set it manually.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token of the Telegram bot that serves as the ONLY admin
# interface for this server. If not set, the app falls back to the token
# hardcoded in server.ts -- for production, set this env var instead and
# remove the fallback value from the source code.
TELEGRAM_BOT_TOKEN="8184142781:AAG0d38hWzsBa3o5y-2SxKEU3VRlLs2-xPM"

# TELEGRAM_ADMIN_CHAT_ID: Telegram chat id (numeric) of the ONLY user allowed
# to control this bot (create/edit/delete client configs, start/stop V2Ray,
# view logs & status). Every other chat is ignored.
TELEGRAM_ADMIN_CHAT_ID="1726923679"
