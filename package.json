{
  "name": "v2ray-telegram-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  }
}
